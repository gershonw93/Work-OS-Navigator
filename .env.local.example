# SyteNav - environment
#
# Copy to .env.local and fill in. Only the first block is required to boot;
# everything else degrades to a normal "not set up yet" state rather than
# crashing, so a fresh environment runs with just Supabase configured.
#
# KEEP THIS FILE CURRENT. It documented 5 of the 24 variables the app actually
# reads, which meant a new environment came up silently missing email, maps,
# QuickBooks and push with nothing to say so.

# ── Required ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Where the app lives ──────────────────────────────────────────────────────
# Optional. Set to split the marketing site off the app:
#   NEXT_PUBLIC_SITE_URL=https://sytenav.com      (marketing only)
#   NEXT_PUBLIC_APP_URL=https://app.sytenav.com   (the product + sign-in)
# Leave NEXT_PUBLIC_APP_URL unset and both live on one host, as before.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# ── Email (SendGrid) ─────────────────────────────────────────────────────────
# Read by lib/email.ts. Unset is a NORMAL state: every send answers
# "not_configured", the caller carries on, and the UI says so plainly instead
# of pretending mail went out.
#
# IMPORTANT - THIS IS THE APP'S KEY ONLY. It covers client portal links, quote
# requests, compliance requests, shared files, client invoices and
# notifications. It does NOT cover team invites, password resets or signup
# confirmations: those are sent by Supabase Auth, which holds its OWN SendGrid
# key configured in the Supabase dashboard, not here. See docs/email-setup.md.
SENDGRID_API_KEY=
EMAIL_FROM=                 # defaults to noreply@sytenav.com
EMAIL_FROM_NAME=            # defaults to SyteNav
EMAIL_REPLY_TO=             # defaults to hello@sytenav.com

# ── QuickBooks Online ────────────────────────────────────────────────────────
# One-way push, SyteNav -> QBO. Unset means "not connected", which every push
# treats as a normal state. QBO_ENV is `sandbox` or `production`.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox
QBO_REDIRECT_URI=

# ── Google Maps ──────────────────────────────────────────────────────────────
# Address autocomplete and geocoding on the project form. Without it, addresses
# are typed by hand and no coordinates are stored.
GOOGLE_MAPS_API_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
# Scanning a quote, a sub bill, a receipt or a compliance document. Without it
# those screens fall back to entering the figures by hand.
ANTHROPIC_API_KEY=

# ── iOS push notifications ───────────────────────────────────────────────────
# APNs over HTTP/2, signed with a .p8 key (lib/push.ts). All four are needed
# together; with any missing, push reports "not configured" and nothing else
# breaks. APNS_PRIVATE_KEY is the whole .p8 contents including the BEGIN/END
# lines - in a shell env file, keep the newlines as literal \n.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=

# Apple's team id for /apple-app-site-association, which is what makes a
# sytenav.com link open the iOS app instead of Safari. Usually the same value
# as APNS_TEAM_ID.
APPLE_TEAM_ID=

# ── Operational ──────────────────────────────────────────────────────────────
# Gate on the internal /admin area.
ADMIN_PIN=
# Shared secret the scheduled jobs present (compliance reminders, and anything
# else under /api/cron). Unset leaves those endpoints unprotected - set it in
# any environment reachable from the internet.
CRON_SECRET=
# Seeding the demo company. DEMO_SEED_SECRET authorises the endpoint;
# DEMO_PASSWORD overrides the demo account's password.
DEMO_SEED_SECRET=
DEMO_PASSWORD=
