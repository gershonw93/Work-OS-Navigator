<?xml version="1.0" encoding="utf-8"?>
<!--
    The small icon Android draws in the status bar and on the notification.

    Android renders it as a SILHOUETTE - only the alpha channel is used, and
    the colour is the system's. Left unset, FCM falls back to the launcher
    icon, whose opaque full-bleed square becomes a solid white block: the
    notification looks like it came from a template rather than from SyteNav.

    The locator arrow from scripts/gen-app-assets.mjs, with the same recentring
    transform (translate 24 24, scale 1.3, translate -25.5 -25) worked out into
    the coordinates, so the status-bar glyph and the home-screen icon agree.
    Wired up by the default_notification_icon meta-data in AndroidManifest.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9.05,8.4 L38.95,20.1 L24.65,25.3 L19.45,39.6 Z" />
</vector>
